  "sfx_banned": [],
  "lint": {
    "sfx_banned": ["record_scratch_*", "cartoon_*", "boing_*", "tada_brass", "cha_ching_*"],
    "whoosh_on_cuts": false,
    "punch_min": 1.10,
    "slow_push": true,
    "dead_span": 4.0,
